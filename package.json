{
  "name": "dsh-capability-hub",
  "description": "DSH 能力中心：技能管理与 MCP 服务器管理（用 JSON 管理配置，由 DSH 官方 MCP 插件连接并注册工具）",
  "version": "0.9.0",
  "type": "module",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "prettier": "3.3.3",
    "typescript": "~5.9.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" build.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" build.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "mcp",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anuii/dsh-capability-hub.git"
  },
  "bugs": {
    "url": "https://github.com/Anuii/dsh-capability-hub/issues"
  },
  "homepage": "https://github.com/Anuii/dsh-capability-hub#readme",
  "author": "anuii <anuii@proton.me>",
  "license": "MIT"
}
